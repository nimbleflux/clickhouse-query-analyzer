<clickhouse>
    <!-- The S3 disk + storage policy moved to s3-storage.xml, mounted only
         by the `s3` compose profile. ClickHouse validates disks at startup,
         so a static S3 disk here would pin the whole dev stack to MinIO —
         whose community images are no longer publicly pullable (Docker Hub
         repo deleted, quay.io repo now auth-required). -->

    <query_log>
        <database>system</database>
        <table>query_log</table>
        <flush_interval_milliseconds>1000</flush_interval_milliseconds>
        <ttl>event_date + INTERVAL 7 DAY</ttl>
    </query_log>
    <query_thread_log>
        <database>system</database>
        <table>query_thread_log</table>
        <flush_interval_milliseconds>1000</flush_interval_milliseconds>
        <ttl>event_date + INTERVAL 3 DAY</ttl>
    </query_thread_log>
    <query_metric_log>
        <database>system</database>
        <table>query_metric_log</table>
        <flush_interval_milliseconds>1000</flush_interval_milliseconds>
        <collect_interval_milliseconds>100</collect_interval_milliseconds>
        <ttl>event_date + INTERVAL 3 DAY</ttl>
    </query_metric_log>
    <query_views_log>
        <database>system</database>
        <table>query_views_log</table>
        <flush_interval_milliseconds>1000</flush_interval_milliseconds>
        <ttl>event_date + INTERVAL 3 DAY</ttl>
    </query_views_log>
    <trace_log>
        <database>system</database>
        <table>trace_log</table>
        <flush_interval_milliseconds>1000</flush_interval_milliseconds>
        <ttl>event_date + INTERVAL 3 DAY</ttl>
    </trace_log>
    <part_log>
        <database>system</database>
        <table>part_log</table>
        <flush_interval_milliseconds>1000</flush_interval_milliseconds>
        <ttl>event_date + INTERVAL 3 DAY</ttl>
    </part_log>

    <!-- Replication dev setup: standalone Keeper + a 2-replica "dev_cluster".
         Shared by both clickhouse nodes via HOSTNAME substitution so each
         advertises its service name (DNS-resolvable on the docker network)
         as its replica identity and interserver host. -->
    <zookeeper>
        <node>
            <host>clickhouse-keeper</host>
            <port>9181</port>
        </node>
    </zookeeper>

    <macros>
        <shard>shard1</shard>
        <replica from_env="HOSTNAME"/>
    </macros>

    <interserver_http_host from_env="HOSTNAME"/>

    <remote_servers>
        <dev_cluster>
            <shard>
                <replica>
                    <host>clickhouse</host>
                    <port>9000</port>
                </replica>
                <replica>
                    <host>clickhouse-2</host>
                    <port>9000</port>
                </replica>
            </shard>
        </dev_cluster>
    </remote_servers>
</clickhouse>
