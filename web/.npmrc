# npm >= 12 denies URL-tarball ("remote") dependencies by default and
# classifies @tailwindcss/oxide-wasm32-wasi as one, which breaks lockfile
# regeneration (EALLOWREMOTE) — most visibly Renovate's artifact updates.
# npm offers no per-URL allowlist (values: all, none, root), so this
# re-enables remote fetches for this project only; the global policy is
# unaffected. Revisit if npm gains finer-grained allow rules.
allow-remote=all
